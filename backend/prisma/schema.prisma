generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  firstName String
  lastName  String
  password  String
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaries        Salary[]
  groupClasses    GroupClass[]
  inventoryLoans  InventoryLoan[]
  maintenanceLogs MaintenanceLog[]
  reservations    Reservation[]    @relation("ReservationRequester")
  uploadedFiles   UploadedFile[]
}

model Salary {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  amount      Decimal
  paymentDate DateTime
  receipt     String?
}

model Member {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  dni       String   @unique
  birthDate DateTime
  email     String?
  phone     String?
  photo     String?
  isActive  Boolean  @default(true)

  memberGroups     MemberGroup[]
  attendances      Attendance[]
  memberFees       MemberFee[]
  memberSocialFees MemberSocialFee[]
}

model Discipline {
  id   Int    @id @default(autoincrement())
  name String @unique

  groupClasses GroupClass[]
  sportsFees   SportsFee[]
}

model GroupClass {
  id           Int        @id @default(autoincrement())
  disciplineId Int
  discipline   Discipline @relation(fields: [disciplineId], references: [id])
  userId       Int
  user         User       @relation(fields: [userId], references: [id])
  schedule     String
  days         String

  memberGroups MemberGroup[]
  attendances  Attendance[]
}

model MemberGroup {
  id            Int        @id @default(autoincrement())
  memberId      Int
  member        Member     @relation(fields: [memberId], references: [id])
  groupClassId  Int
  groupClass    GroupClass @relation(fields: [groupClassId], references: [id])
  sportsFeePaid Boolean    @default(false)

  @@unique([memberId, groupClassId])
}

model Attendance {
  id           Int        @id @default(autoincrement())
  groupClassId Int
  groupClass   GroupClass @relation(fields: [groupClassId], references: [id])
  memberId     Int
  member       Member     @relation(fields: [memberId], references: [id])
  date         DateTime
  present      Boolean
}

model Inventory {
  id                Int      @id @default(autoincrement())
  name              String
  category          String?
  location          String?
  totalQuantity     Int
  availableQuantity Int
  minimumQuantity   Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  loans InventoryLoan[]

  @@index([active])
}

model InventoryLoan {
  id           Int       @id @default(autoincrement())
  itemId       Int
  item         Inventory @relation(fields: [itemId], references: [id])
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  quantity     Int       @default(1)
  checkoutDate DateTime
  dueDate      DateTime?
  returnDate   DateTime?
  returned     Boolean   @default(false)
  notes        String?

  @@index([itemId, returned])
  @@index([userId, returned])
}

model Facility {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  active      Boolean  @default(true)
  reservable  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  maintenanceLogs MaintenanceLog[]
  reservations    Reservation[]
}

model MaintenanceLog {
  id              Int       @id @default(autoincrement())
  facilityId      Int
  facility        Facility  @relation(fields: [facilityId], references: [id])
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  date            DateTime
  taskDescription String
  suppliesNeeded  String?
  status          String    @default("PENDING")
  priority        String    @default("MEDIUM")
  resolvedAt      DateTime?
  files           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}

model Reservation {
  id         Int      @id @default(autoincrement())
  facilityId Int
  facility   Facility @relation(fields: [facilityId], references: [id])
  userId     Int
  user       User     @relation("ReservationRequester", fields: [userId], references: [id])
  startAt    DateTime
  endAt      DateTime
  status     String   @default("CONFIRMED")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([facilityId, startAt, endAt])
  @@index([userId, status])
}

model UploadedFile {
  id           Int      @id @default(autoincrement())
  originalName String
  storedName   String
  mimeType     String
  size         Int
  module       String
  refId        Int?
  url          String
  uploadedById Int?
  user         User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model SportsFee {
  id           Int        @id @default(autoincrement())
  name         String
  amount       Decimal
  category     String // Infantil | Juvenil | Adulto | Senior
  description  String?
  active       Boolean    @default(true)
  disciplineId Int
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  memberFees MemberFee[]
}

model SocialFee {
  id        Int      @id @default(autoincrement())
  category  String   @unique // Infantil | Juvenil | Adulto | Senior
  amount    Decimal
  dueDay    Int      @default(10)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  memberSocialFees MemberSocialFee[]
}

model MemberSocialFee {
  id          Int       @id @default(autoincrement())
  memberId    Int
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  socialFeeId Int
  socialFee   SocialFee @relation(fields: [socialFeeId], references: [id])
  periodMonth Int
  periodYear  Int
  amount      Decimal
  paid        Boolean   @default(false)
  paidAt      DateTime?
  receipt     String?
  createdAt   DateTime  @default(now())

  @@unique([memberId, periodMonth, periodYear])
}

model MemberFee {
  id        Int       @id @default(autoincrement())
  memberId  Int
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  feeId     Int
  fee       SportsFee @relation(fields: [feeId], references: [id], onDelete: Cascade)
  paid      Boolean   @default(false)
  paidAt    DateTime?
  receipt   String?
  createdAt DateTime  @default(now())

  @@unique([memberId, feeId])
}
